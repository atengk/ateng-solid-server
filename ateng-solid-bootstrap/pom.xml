<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.atengk</groupId>
        <artifactId>ateng-solid-server</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ateng-solid-bootstrap</artifactId>
    <packaging>jar</packaging>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>ateng-solid 单体聚合启动宿主、双模外部配置、Flyway 迁移与 ArchUnit 架构守卫模块</description>

    <dependencies>
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-solid-auth</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-solid-system</artifactId>
        </dependency>

        <!-- 迁移底座（已随 ateng-boot:1.2.0 正式发布并锁版启用） -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-boot-flyway</artifactId>
        </dependency>

        <!-- 可观测与 Actuator 管理面底座（仅限启动宿主装配，业务模块零编译依赖；dev 消费 1.2.1-SNAPSHOT 含 B24/B25，合入 main 前锁回正式版） -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-boot-observability</artifactId>
        </dependency>

        <!-- Redis Lettuce 连接池支撑（版本由 Spring Boot BOM 纳管，显式引入以激活 spring.data.redis.lettuce.pool.*） -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- Caffeine 高性能 L1 本地缓存引擎（版本由 Spring Boot BOM 纳管，激活 TwoLevelCacheManager W-TinyLFU L1 缓存） -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- 数据库驱动与 Flyway MySQL 适配 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- S3 兼容对象存储 SDK 运行时（对接 RustFS / MinIO / 阿里云 OSS 等） -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>apache-client</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 离线自洽测试与架构守卫 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
